{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "tests/*": "deny",
      "e2e/*": "deny"
    },
    "bash": {
      "*": "ask",
      "npm run *": "allow",
      "npm test": "allow",
      "npx tsc *": "allow",
      "npx vitest *": "allow",
      "npx playwright *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "rm *": "deny"
    }
  }
}
